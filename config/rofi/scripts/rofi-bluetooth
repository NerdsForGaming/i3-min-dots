#!/usr/bin/env bash
# Themed bluetoothctl manager.
#
# Same display-vs-key pattern as rofi-network: the displayed line and
# the underlying action / MAC live in a TAB-separated lookup table.

set -u

THEME="${RICE_ROFI_THEME:-$HOME/.config/rofi/config.rasi}"
notify() { command -v notify-send >/dev/null && notify-send "bluetooth" "$@" || true; }
pick()   { rofi -dmenu -i -theme "$THEME" -no-custom -format 's' "$@"; }

# ─── not installed? Offer the install command. ────────────────────
if ! command -v bluetoothctl >/dev/null; then
    msg="bluez isn't installed yet.
Install it with:

  sudo pacman -S bluez bluez-utils"
    choice=$(printf '%s\n%s\n' \
        "󰗀    copy install command" \
        "  dismiss" | pick -p "  bluetooth" -mesg "$msg")
    if [[ "$choice" == *"copy"* ]] && command -v xclip >/dev/null; then
        printf 'sudo pacman -S bluez bluez-utils' | xclip -selection clipboard
        notify "install command copied to clipboard"
    fi
    exit 0
fi

# ─── no adapter? ──────────────────────────────────────────────────
if ! bluetoothctl show 2>/dev/null | grep -q '^Controller'; then
    rofi -e "no bluetooth adapter detected." -theme "$THEME"
    exit 0
fi

powered=$(bluetoothctl show | awk '/Powered:/ {print $2; exit}')

TABLE=$(mktemp)
trap 'rm -f "$TABLE"' EXIT

{
    if [ "$powered" = "yes" ]; then
        printf '%s\t%s\n' "󰂲    turn bluetooth off" "ACT:power-off"
        printf '%s\t%s\n' "󰂰    scan for 8s"        "ACT:scan"
    else
        printf '%s\t%s\n' "    turn bluetooth on" "ACT:power-on"
    fi
    printf '%s\t%s\n' "──────────────────────────────────────────" "ACT:nop"

    if [ "$powered" = "yes" ]; then
        # Paired devices first (connected ones marked).
        while IFS= read -r line; do
            mac=$(awk '{print $2}' <<<"$line")
            name=$(cut -d' ' -f3- <<<"$line")
            [ -z "$mac" ] && continue
            connected=$(bluetoothctl info "$mac" 2>/dev/null \
                        | awk '/Connected:/ {print $2; exit}')
            [ "$connected" = "yes" ] && marker="●" || marker="▪"
            short=$(printf '%-28.28s' "$name")
            printf '%s  %s  %s\tDEV:%s\n' "$marker" "$short" "$mac" "$mac"
        done < <(bluetoothctl devices Paired 2>/dev/null)

        # Then discovered-but-not-paired.
        while IFS= read -r line; do
            mac=$(awk '{print $2}' <<<"$line")
            name=$(cut -d' ' -f3- <<<"$line")
            [ -z "$mac" ] && continue
            short=$(printf '%-28.28s' "$name")
            printf '%s  %s  %s\tDEV:%s\n' "+" "$short" "$mac" "$mac"
        done < <(bluetoothctl devices 2>/dev/null \
                 | grep -vxFf <(bluetoothctl devices Paired 2>/dev/null))
    fi
} > "$TABLE"

if [ "$powered" = "yes" ]; then
    n=$(bluetoothctl devices Connected 2>/dev/null | awk '{$1=$2=""; sub(/^  /,""); print}' | head -1)
    mesg="bluetooth: <b>ON</b>"
    [ -n "$n" ] && mesg="$mesg   ·   <b>$n</b>"
else
    mesg="bluetooth: <b>OFF</b>"
fi

choice=$(cut -f1 < "$TABLE" | pick -p "  bluetooth" -mesg "$mesg")
[ -z "$choice" ] && exit 0

key=$(awk -F'\t' -v line="$choice" '$1 == line {print $2; exit}' "$TABLE")
[ -z "$key" ] && exit 0

case "$key" in
    ACT:power-off)  bluetoothctl power off >/dev/null ;;
    ACT:power-on)   bluetoothctl power on  >/dev/null; sleep 1; exec "$0" ;;
    ACT:scan)
        notify "scanning..."
        bluetoothctl --timeout 8 scan on >/dev/null 2>&1
        exec "$0"
        ;;
    ACT:nop)        : ;;
    DEV:*)
        mac=${key#DEV:}
        connected=$(bluetoothctl info "$mac" 2>/dev/null \
                    | awk '/Connected:/ {print $2; exit}')
        if [ "$connected" = "yes" ]; then
            bluetoothctl disconnect "$mac" >/dev/null \
                && notify "disconnected $mac"
        else
            paired=$(bluetoothctl info "$mac" 2>/dev/null \
                     | awk '/Paired:/ {print $2; exit}')
            if [ "$paired" != "yes" ]; then
                # Pair + trust before connecting so reconnects are
                # automatic next time.
                bluetoothctl pair "$mac" >/dev/null 2>&1 || true
                bluetoothctl trust "$mac" >/dev/null 2>&1 || true
            fi
            bluetoothctl connect "$mac" >/dev/null 2>&1 \
                && notify "connected $mac" \
                || notify "connect failed: $mac"
        fi
        ;;
esac
