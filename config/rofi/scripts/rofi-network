#!/usr/bin/env bash
# Themed nmcli-driven network picker. Bound to the polybar network
# module's left-click. Uses the main rofi theme for visual match.

set -u

THEME="${RICE_ROFI_THEME:-$HOME/.config/rofi/config.rasi}"

pick() {
    rofi -dmenu -i -theme "$THEME" -no-custom -format 's' "$@"
}

prompt_pw() {
    rofi -dmenu -password -theme "$THEME" -p "  $1" -lines 0 -format 's'
}

notify() { command -v notify-send >/dev/null && notify-send "$@" || true; }

wifi_state=$(nmcli -t -f WIFI radio 2>/dev/null)
[ -z "$wifi_state" ] && wifi_state="disabled"

# Build the entry list. Header items use a leading character that's
# easy to grep back when reading the user's choice.
entries=()
case "$wifi_state" in
    enabled)  entries+=("[~] Toggle wifi: ON") ;;
    *)        entries+=("[~] Toggle wifi: OFF") ;;
esac
entries+=("[~] Disconnect active")
entries+=("[~] ─── networks ───")

if [ "$wifi_state" = "enabled" ]; then
    while IFS=$'\t' read -r in_use ssid sig sec; do
        [ -z "$ssid" ] && continue
        case "${sig:-0}" in
            ''|0|[0-9]) bars="▂   " ;;
            [1-3][0-9]) bars="▂▄  " ;;
            [4-6][0-9]) bars="▂▄▆ " ;;
            *)          bars="▂▄▆█" ;;
        esac
        marker=" "
        [ "$in_use" = "*" ] && marker=""
        lock=" "
        [ -n "$sec" ] && [ "$sec" != "--" ] && lock=""
        entries+=("$marker $bars $lock  $ssid")
    done < <(nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY device wifi list 2>/dev/null \
             | awk -F: '!seen[$2]++' )
fi

choice=$(printf '%s\n' "${entries[@]}" | pick -p "  network" -mesg "Pick a network, [~] for actions")

[ -z "$choice" ] && exit 0

case "$choice" in
    "[~] Toggle wifi: ON")
        nmcli radio wifi off
        ;;
    "[~] Toggle wifi: OFF")
        nmcli radio wifi on
        ;;
    "[~] Disconnect active")
        active=$(nmcli -t -f NAME c show --active | head -1)
        [ -n "$active" ] && nmcli c down "$active"
        ;;
    "[~] ─── networks ───")
        exit 0
        ;;
    *)
        # Strip the leading marker/bars/lock; everything after the
        # last double-space is the SSID.
        ssid=$(printf '%s' "$choice" | sed -E 's/^[^A-Za-z0-9]+//; s/^[▂▄▆█ ]+//; s/^[  ]+//')
        # Already saved? -> just bring it up.
        if nmcli -t -f NAME c show | grep -Fxq "$ssid"; then
            nmcli c up "$ssid" >/dev/null 2>&1 \
                && notify "wifi" "Connected to $ssid" \
                || notify "wifi" "Failed to connect to $ssid"
            exit 0
        fi
        # Secure network? Ask for password.
        sec=$(nmcli -t -f SSID,SECURITY device wifi list 2>/dev/null \
              | awk -F: -v s="$ssid" '$1 == s {print $2; exit}')
        if [ -n "$sec" ] && [ "$sec" != "--" ]; then
            pw=$(prompt_pw "password for $ssid")
            [ -z "$pw" ] && exit 0
            if nmcli d wifi connect "$ssid" password "$pw" >/dev/null 2>&1; then
                notify "wifi" "Connected to $ssid"
            else
                notify "wifi" "Failed to connect to $ssid"
            fi
        else
            nmcli d wifi connect "$ssid" >/dev/null 2>&1 \
                && notify "wifi" "Connected to $ssid" \
                || notify "wifi" "Failed to connect to $ssid"
        fi
        ;;
esac
