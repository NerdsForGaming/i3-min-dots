#!/usr/bin/env bash
# rice-update-full — rice-update + system packages (pacman + yay).
#
# Runs in a kitty terminal when launched from the popup so the user
# can see pacman's prompts and progress. Run directly from a shell
# for the same effect.

set -euo pipefail
SELF_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
source "$SELF_DIR/_rice-common.sh"

say() { printf '\033[1;33m::\033[0m %s\n' "$*"; }
warn() { printf '\033[1;31m!!\033[0m %s\n' "$*" >&2; }

say "Updating rice dotfiles..."
"$SELF_DIR/rice-update" || warn "rice-update reported a problem; continuing."

if command -v pacman >/dev/null; then
    say "Running pacman -Syu (sudo will prompt)..."
    sudo pacman -Syu --noconfirm || warn "pacman update failed."
else
    warn "pacman not found — skipping system update."
fi

if command -v yay >/dev/null; then
    say "Running yay -Syu..."
    yay -Syu --noconfirm || warn "yay update failed."
else
    warn "yay not installed — skipping AUR update."
fi

say "All done. You may want to log out + back in if kernel or display"
say "packages were updated."

# If we were launched in a terminal window from the popup, keep it
# open so the user can read the summary.
if [ -t 0 ] && [ "${RICE_HOLD_TERM:-0}" = "1" ]; then
    printf '\nPress Enter to close...'
    read -r _
fi
